create table user_product (
                              id varchar(10) not null,
                              email varchar(255),
                              drive_application_folder_id varchar(255),
                              primary key (id)
);


create table wedding_memory_data (
                                  id bigserial primary key,
                                  user_product_id varchar(10) not null,
                                  male_name varchar(255),
                                  female_name varchar(255),
                                  date date,
                                  constraint fk_wedding_memory_data_user_product
                                      foreign key (user_product_id) references user_product(id)
);



create table place_to_visit_data (
                                     id bigserial primary key,
                                     user_product_id varchar(10) not null,
                                     name varchar(255),
                                     date date,
                                     constraint fk_place_to_visit_data_user_product
                                         foreign key (user_product_id) references user_product(id)
);